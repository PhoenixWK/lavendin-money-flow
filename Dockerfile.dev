# Multi-stage build for development
FROM maven:3.9.6-eclipse-temurin-21 AS build

WORKDIR /app

# Copy pom.xml first to leverage Docker layer caching
COPY pom.xml .

# Copy .mvn folder for Maven wrapper settings
COPY .mvn .mvn

# Download dependencies with explicit repository settings for snapshots
RUN mvn dependency:resolve -B --update-snapshots

# Copy source code
COPY src ./src

# Build the application
RUN mvn clean package -DskipTests -DskipTests=true --quiet

# Runtime stage
FROM eclipse-temurin:21-jre

WORKDIR /app

# Copy the built JAR from the build stage
COPY --from=build /app/target/tracking-money-flow-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
